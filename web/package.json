{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:catalog": "node scripts/generate-catalog-assets.mjs",
    "generate:process-image": "npm run generate:process-images",
    "generate:process-images": "node scripts/generate-process-article-image.mjs",
    "generate:process-images:all": "node scripts/generate-process-article-image.mjs --all",
    "generate:verification-queue": "node scripts/generate-field-verification-queue.mjs",
    "generate:warroom-map": "node scripts/generate-warroom-map-data.mjs",
    "generate:warroom-map:all": "node scripts/generate-warroom-map-data.mjs --all",
    "generate:article-texts": "node scripts/generate-article-text-registry.mjs --write",
    "discover:candidates": "node scripts/discover-news-candidates.mjs",
    "check:skeletons": "node scripts/detect-template-skeletons.mjs --gate-r2",
    "check:basis-in-force": "node scripts/check-basis-in-force.mjs",
    "check:freshness": "node scripts/sync-verification.mjs --check",
    "predev": "npm run generate:catalog && npm run generate:verification-queue && npm run generate:process-images",
    "dev": "next dev",
    "prebuild": "npm run generate:catalog && npm run generate:verification-queue && npm run generate:process-images",
    "build": "npm run generate:app-export && next build",
    "start": "next start",
    "lint": "eslint",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:mega-projects": "node scripts/validate-mega-projects.mjs",
    "validate:article-texts": "node scripts/validate-article-text-registry.mjs",
    "validate:process-images": "node scripts/validate-process-images.mjs",
    "sync:sources": "node scripts/sync-verification.mjs",
    "verify:articles": "node scripts/verify-articles.mjs",
    "test:article-parser": "node --test scripts/article-citations.test.mjs scripts/admin-rule-service.test.mjs scripts/law-service.test.mjs scripts/legal-source-resolution.test.mjs scripts/source-merging.test.mjs",
    "test:news-candidates": "node --test scripts/news-candidates.test.mjs",
    "test:process-layout": "node --test scripts/process-layout.test.mjs",
    "test:process-warnings": "node --test scripts/process-warnings.test.mjs",
    "generate:app-export": "node scripts/generate-app-export.mjs",
    "collect:warroom-signals": "node scripts/collect-warroom-signals.mjs",
    "discover:institutions": "node scripts/discover-institution-candidates.mjs",
    "generate:loop-status": "node scripts/generate-loop-status.mjs",
    "generate:loop-briefing": "node scripts/generate-loop-briefing.mjs",
    "promote:process-drafts": "node scripts/promote-institution-candidate-drafts.mjs",
    "test:news-process-drafts": "node --test scripts/news-to-process-draft.test.mjs",
    "render:process-draft-pngs": "node scripts/render-process-draft-pngs.mjs",
    "promote:process-drafts:png": "node scripts/promote-news-to-process-drafts.mjs && node scripts/render-process-draft-pngs.mjs",
    "promote:institution-drafts": "node scripts/promote-institution-candidate-drafts.mjs",
    "test:institution-drafts": "node --test scripts/institution-candidate-to-process-draft.test.mjs",
    "pipeline:institution-full": "node scripts/pipeline-institution-full.mjs",
    "pipeline:register": "node scripts/register-clear-basis-from-queue.mjs",
    "docs:ontology-stats": "node scripts/ontology-stats.mjs",
    "check:ontology-stats": "node scripts/ontology-stats.mjs --check",
    "check:basis-text": "node scripts/check-basis-text.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}

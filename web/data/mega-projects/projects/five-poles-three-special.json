 "projectFamily": "balanced-growth",
 "asOfDate": "2026-08-19",
 "status": "planning",
 "summary": "5개 초광역권(수도권·충청권·호남권·대구경북권·동남권)과 3개 특별자치도(강원·전북·제주)를 중심으로 국가를 재편하는 균형성장 전략의 절차 지도. 지방시대위원회 추진전략 설계도(3대 분야 11개 전략과제 144개 세부과제)를 골격으로 법제·협약·재정·권한이양의 관문을 잇는다.",
 "scope": {
  "coverage": "전국 — 5개 초광역권 + 3개 특별자치도",
  "vision": "자치분권 기반의 5극3특 중심 국가균형성장",
  "targets": "잠재성장률 3%+, 비수도권 GRDP 50%+",
  "planHorizon": "2025~2030(국정운영 5개년)",
  "legalStatus": "지방분권균형발전법 개정 국회 통과, 지방자치법 개정·권한이양 특별법은 진행 중"
 },
 "parameters": {
  "investCorpActPassed": {
   "value": null,
   "status": "unknown",
   "reason": "동남권·충청권 지역투자공사 법안이 상정·소위 단계로 통과 여부 미확정"
  },
  "regionalSlgEstablished": {
   "value": null,
   "status": "unknown",
   "reason": "부울경 특별연합 해산 전례가 있어 권역별 특자체 설립 여부는 권역마다 다름"
  },
  "growthSupportActEnacted": {
   "value": null,
   "status": "unknown",
   "reason": "광역권 성장지원 특별법은 제정 추진 단계"
  }
 },

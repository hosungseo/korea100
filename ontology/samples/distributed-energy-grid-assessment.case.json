 "rules": [
  {
   "id": "rule:assessment-precedes-approval",
   "name": "평가서는 승인등을 신청하기 3개월 전까지 제출한다",
   "applies_to": [
    "step:P17",
    "doc:grid-assessment"
   ],
   "inputs": [
    "approval_application_date"
   ],
   "predicate": "submit_by(approval_application_date - 3 months)",
   "output": {
    "schedule": "후속 인허가 신청일에서 3개월을 역산해 평가서 제출 시점을 잡는다",
    "note": "법률은 '대통령령으로 정하는 시기'라고만 한다. 실제 기한은 시행령에 있다."
   },
   "statute_ref": [
    {
     "law": "분산에너지 활성화 특별법",
     "article": "제24조제1항"
    },
    {
     "law": "분산에너지 활성화 특별법 시행령",
     "article": "제28조제1항"
    }
   ],
   "stop_if_unverified": true
  },
  {
   "id": "rule:power-policy-council-review",
   "name": "검토는 전력정책심의회 심의를 거쳐야 한다",

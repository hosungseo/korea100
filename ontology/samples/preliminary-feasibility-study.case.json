   ],
   "inputs": [
    "total_project_cost",
    "national_support"
   ],
   "predicate": "if total_cost >= 50_000_000_000 and national_support >= 30_000_000_000 then pfs_target else not_target",
   "output": {
    "blocked": "총사업비와 국가 재정지원 규모가 확정되어야 판정할 수 있다"
